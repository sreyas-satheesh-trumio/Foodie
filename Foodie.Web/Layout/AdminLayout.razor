@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="flex h-screen bg-slate-950 text-slate-100">
    <aside class="w-64 bg-slate-900 border-r border-slate-800">
        <div class="p-6 border-b border-slate-800">
            <h1 class="text-2xl font-bold text-white">Foodie Admin</h1>
        </div>
        <nav class="space-y-2 px-4 py-4">
            <NavLink class="block px-4 py-2 rounded-lg hover:bg-slate-800 transition" href="/admin/orders">
                All Orders
            </NavLink>
            <NavLink class="block px-4 py-2 rounded-lg hover:bg-slate-800 transition" href="/admin/menu">
                Manage Menu
            </NavLink>
            <button @onclick="HandleLogout"
                class="w-full mt-8 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition font-medium">
                Logout
            </button>
        </nav>
    </aside>

    <main class="flex-1 overflow-auto bg-slate-950">
        @Body
    </main>
</div>

@code {
    private void HandleLogout()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}