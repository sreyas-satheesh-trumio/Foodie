@page "/"
@using Foodie.Web.Services
@using System.Text.Json
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Browse Menu - Foodie</PageTitle>

<style>
    .menu-card {
        min-width: 300px;
        max-width: 320px;
    }

    .price-text {
        font-size: 24px;
        font-weight: 700;
        color: #facc15;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }
</style>

<div style="padding: 2rem; background-color: #09090b; color: #e2e8f0; min-height: 100vh;">
    @if (isLoading)
    {
        <div style="display: flex; justify-content: center; align-items: center; padding: 3rem;">
            <div style="text-align: center;">
                <div
                    style="display: inline-block; animation: spin 1s linear infinite; width: 48px; height: 48px; border: 3px solid #3f3f46; border-top-color: #facc15; border-radius: 50%; margin-bottom: 1rem;">
                </div>
                <p style="color: #a1a5ab;">Loading menu items...</p>
            </div>
        </div>
    }
    else if (menuItems.Count == 0)
    {
        <div style="text-align: center; padding: 3rem;">
            <p style="color: #6b7280; font-size: 18px;">No menu items available</p>
        </div>
    }
    else
    {
        <div class="card-container">
            @foreach (var item in menuItems)
            {
                <Card Style="background-color: #18181b; border: 1px solid #27272a; min-width: 300px; max-width: 320px;">
                    <CardHeader Style="padding: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #27272a;">
                        <h3 style="font-size: 18px; font-weight: 700; color: white; margin: 0 0 0.5rem 0;">@item.Name</h3>
                        <p style="font-size: 14px; color: #a1a5ab; margin: 0;">@item.Category</p>
                    </CardHeader>
                    <CardContent Style="padding: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                            <span class="price-text">₹@item.Price.ToString("F2")</span>
                            @if (!item.IsAvailable)
                            {
                                <span
                                    style="padding: 0.375rem 0.75rem; background-color: rgba(185, 28, 28, 0.4); color: #fca5a5; font-size: 12px; font-weight: 600; border-radius: 9999px;">Unavailable</span>
                            }
                            else
                            {
                                <span
                                    style="padding: 0.375rem 0.75rem; background-color: rgba(34, 197, 94, 0.4); color: #86efac; font-size: 12px; font-weight: 600; border-radius: 9999px;">Available</span>
                            }
                        </div>

                        @if (item.IsAvailable)
                        {
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <button @onclick="() => DecreaseQuantity(item.Id)" disabled="@(GetQuantity(item.Id) == 0)"
                                    style="flex: 1; padding: 0.5rem; background-color: #27272a; color: #e2e8f0; border: none; border-radius: 0.375rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s; opacity: @(GetQuantity(item.Id) == 0 ? "0.5" : "1");"
                                    onmouseover="this.style.backgroundColor='#3f3f46'"
                                    onmouseout="this.style.backgroundColor='#27272a'">
                                    −
                                </button>
                                <span
                                    style="flex: 1; text-align: center; font-weight: 700; color: white;">@GetQuantity(item.Id)</span>
                                <button @onclick="() => IncreaseQuantity(item.Id)"
                                    style="flex: 1; padding: 0.5rem; background-color: #facc15; color: #18181b; border: none; border-radius: 0.375rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s;"
                                    onmouseover="this.style.backgroundColor='#eab308'"
                                    onmouseout="this.style.backgroundColor='#facc15'">
                                    +
                                </button>
                            </div>
                        }
                    </CardContent>
                </Card>
            }
        </div>

        <!-- Checkout Button (Fixed) -->
        @if (cart.Count > 0)
        {
            <div style="position: fixed; bottom: 2rem; right: 2rem; z-index: 50;">
                <button @onclick="ShowOrderDialog"
                    style="padding: 1rem 1.5rem; background-color: #facc15; color: #18181b; font-weight: 700; border-radius: 9999px; border: none; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); cursor: pointer; transition: background-color 0.2s; font-size: 16px; display: flex; align-items: center; gap: 0.5rem;"
                    onmouseover="this.style.backgroundColor='#eab308'" onmouseout="this.style.backgroundColor='#facc15'">
                    🛒 Checkout (@cart.Sum(c => c.Value) items)
                </button>
            </div>
        }
    }
</div>

<!-- Order Dialog Modal -->
@if (showOrderDialog)
{
    <div
        style="position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.6); display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 50;">
        <Card
            Style="background-color: #18181b; border: 1px solid #27272a; max-width: 500px; width: 100%; max-height: 80vh; overflow-y: auto;">
            <CardHeader
                Style="position: sticky; top: 0; background-color: #27272a; padding: 1.5rem; border-bottom: 1px solid #3f3f46; z-index: 10;">
                <h2 style="font-size: 24px; font-weight: 700; color: white; margin: 0;">Review Order</h2>
            </CardHeader>

            <CardContent Style="padding: 1.5rem;">
                <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
                    @foreach (var itemId in cart.Keys)
                    {
                        var item = menuItems.First(m => m.Id == itemId);
                        var quantity = cart[itemId];
                        var total = item.Price * quantity;

                        <div
                            style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; background-color: #27272a; border-radius: 0.375rem; border: 1px solid #3f3f46;">
                            <div>
                                <p style="font-weight: 600; color: white; margin: 0 0 0.25rem 0;">@item.Name</p>
                                <p style="font-size: 14px; color: #a1a5ab; margin: 0;">@quantity × ₹@item.Price.ToString("F2")
                                </p>
                            </div>
                            <p style="font-weight: 700; color: #facc15;">₹@total.ToString("F2")</p>
                        </div>
                    }
                </div>

                <div style="border-top: 1px solid #27272a; padding-top: 1rem; margin-bottom: 1.5rem;">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; font-size: 18px; font-weight: 700;">
                        <span style="color: #e2e8f0;">Total:</span>
                        <span style="color: #facc15;">₹@orderTotal.ToString("F2")</span>
                    </div>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label
                        style="display: block; font-size: 14px; font-weight: 500; color: #cbd5e1; margin-bottom: 0.5rem;">Customer
                        Name</label>
                    <input type="text" @bind="customerName" placeholder="Your name"
                        style="width: 100%; padding: 0.625rem 1rem; background-color: #09090b; border: 1px solid #27272a; border-radius: 0.375rem; color: white; font-size: 14px; box-sizing: border-box;" />
                </div>

                <div style="display: flex; gap: 0.75rem;">
                    <button @onclick="CloseOrderDialog"
                        style="flex: 1; padding: 0.75rem 1rem; border: 1px solid #3f3f46; color: #cbd5e1; background-color: transparent; border-radius: 0.375rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s;"
                        onmouseover="this.style.backgroundColor='#27272a'"
                        onmouseout="this.style.backgroundColor='transparent'">
                        Cancel
                    </button>
                    <button @onclick="PlaceOrder" disabled="@(string.IsNullOrEmpty(customerName) || isSubmitting)"
                        style="flex: 1; padding: 0.75rem 1rem; background-color: #facc15; color: #18181b; border: none; border-radius: 0.375rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s; opacity: @(string.IsNullOrEmpty(customerName) || isSubmitting ? "0.5" : "1");"
                        onmouseover="if(!this.disabled)this.style.backgroundColor='#eab308'"
                        onmouseout="if(!this.disabled)this.style.backgroundColor='#facc15'">
                        @if (isSubmitting)
                        {
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>Place Order</span>
                        }
                    </button>
                </div>
            </CardContent>
        </Card>
    </div>
}

@code {
    private List<MenuItemResponseDto> menuItems = new();
    private Dictionary<Guid, int> cart = new();
    private string searchQuery = "";
    private string selectedCategory = "";
    private bool isLoading = true;
    private bool showOrderDialog = false;
    private bool isSubmitting = false;
    private string customerName = "";
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMenuItems();
    }

    private async Task LoadMenuItems()
    {
        isLoading = true;
        try
        {
            menuItems = await ApiClient.GetMenuItemsAsync(
            string.IsNullOrEmpty(searchQuery) ? null : searchQuery,
            string.IsNullOrEmpty(selectedCategory) ? null : selectedCategory
            );
        }
        catch (Exception)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        await LoadMenuItems();
    }

    private async Task HandleCategoryChange(ChangeEventArgs e)
    {
        await LoadMenuItems();
    }

    private async Task HandleCategorySelectChange(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? "";
        await LoadMenuItems();
    }

    private async Task ResetFilters()
    {
        searchQuery = "";
        selectedCategory = "";
        await LoadMenuItems();
    }

    private void IncreaseQuantity(Guid itemId)
    {
        if (cart.ContainsKey(itemId))
            cart[itemId]++;
        else
            cart[itemId] = 1;
    }

    private void DecreaseQuantity(Guid itemId)
    {
        if (cart.ContainsKey(itemId) && cart[itemId] > 0)
        {
            cart[itemId]--;
            if (cart[itemId] == 0)
                cart.Remove(itemId);
        }
    }

    private int GetQuantity(Guid itemId) => cart.ContainsKey(itemId) ? cart[itemId] : 0;

    private decimal GetItemTotal(Guid itemId)
    {
        var item = menuItems.FirstOrDefault(m => m.Id == itemId);
        return item != null ? item.Price * GetQuantity(itemId) : 0;
    }

    private decimal orderTotal => cart.Sum(c => GetItemTotal(c.Key));

    private void ShowOrderDialog()
    {
        showOrderDialog = true;
        customerName = "";
    }

    private void CloseOrderDialog()
    {
        showOrderDialog = false;
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrEmpty(customerName) || cart.Count == 0)
            return;

        isSubmitting = true;
        try
        {
            var orderDto = new OrderCreateDto
            {
                OrderItems = cart.Select(c => new OrderItemsCreateDto
                {
                    MenuItemId = c.Key,
                    Quantity = c.Value
                }).ToList()
            };

            var result = await ApiClient.CreateOrderAsync(orderDto);
            if (result != null)
            {
                cart.Clear();
                showOrderDialog = false;
                Navigation.NavigateTo("/orders");
            }
        }
        catch (Exception ex)
        {
            // Handle error
        }
        finally
        {
            isSubmitting = false;
        }
    }
}