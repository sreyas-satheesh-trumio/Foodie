@page "/"
@using Foodie.Web.Services
@using System.Text.Json
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Browse Menu - Foodie</PageTitle>

<div class="p-8 bg-slate-950 text-slate-100 min-h-screen">
    @if (isLoading)
    {
        <div class="flex justify-center items-center py-12">
            <div class="text-center">
                <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-orange-500 mb-4"></div>
                <p class="text-gray-600">Loading menu items...</p>
            </div>
        </div>
    }
    else if (menuItems.Count == 0)
    {
        <div class="text-center py-12">
            <p class="text-gray-500 text-lg">No menu items available</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var item in menuItems)
            {
                <div
                    class="bg-slate-900 rounded-xl shadow-md hover:shadow-lg transition overflow-hidden border border-slate-800">
                    <div class="p-4">
                        <h3 class="text-lg font-bold text-white">@item.Name</h3>
                        <p class="text-sm text-slate-300 mb-3">@item.Category</p>

                        <div class="flex items-center justify-between mb-4">
                            <span class="text-2xl font-bold text-amber-300">₹@item.Price.ToString("F2")</span>
                            @if (!item.IsAvailable)
                            {
                                <span
                                    class="px-3 py-1 bg-red-900/60 text-red-200 text-xs font-semibold rounded-full">Unavailable</span>
                            }
                            else
                            {
                                <span
                                    class="px-3 py-1 bg-emerald-900/60 text-emerald-200 text-xs font-semibold rounded-full">Available</span>
                            }
                        </div>

                        @if (item.IsAvailable)
                        {
                            <div class="flex items-center gap-2">
                                <button @onclick="() => DecreaseQuantity(item.Id)" disabled="@(GetQuantity(item.Id) == 0)"
                                    class="flex-1 px-3 py-2 bg-slate-800 text-slate-100 rounded-lg hover:bg-slate-700 transition font-semibold disabled:opacity-50 disabled:cursor-not-allowed">
                                    −
                                </button>
                                <span class="flex-1 text-center font-bold text-white">@GetQuantity(item.Id)</span>
                                <button @onclick="() => IncreaseQuantity(item.Id)"
                                    class="flex-1 px-3 py-2 bg-amber-400 text-slate-900 rounded-lg hover:bg-amber-300 transition font-semibold">
                                    +
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Add to Cart Button (Fixed) -->
        @if (cart.Count > 0)
        {
            <div class="fixed bottom-8 right-8">
                <button @onclick="ShowOrderDialog"
                    class="px-6 py-4 bg-amber-400 text-slate-900 font-bold rounded-full shadow-lg hover:bg-amber-300 transition flex items-center gap-2 text-lg">
                    Checkout (@cart.Sum(c => c.Value) items)
                </button>
            </div>
        }
    }
</div>

<!-- Order Dialog -->
@if (showOrderDialog)
{
    <div class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center p-4 z-50">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl max-w-md w-full max-h-96 overflow-y-auto">
            <div class="sticky top-0 bg-slate-800 px-6 py-4 text-white border-b border-slate-700">
                <h2 class="text-2xl font-bold">Review Order</h2>
            </div>

            <div class="p-6 text-slate-100">
                <div class="space-y-3 mb-6">
                    @foreach (var itemId in cart.Keys)
                    {
                        var item = menuItems.First(m => m.Id == itemId);
                        var quantity = cart[itemId];
                        var total = item.Price * quantity;

                        <div class="flex justify-between items-center p-3 bg-slate-800 rounded-lg">
                            <div>
                                <p class="font-semibold text-white">@item.Name</p>
                                <p class="text-sm text-slate-300">@quantity × ₹@item.Price.ToString("F2")</p>
                            </div>
                            <p class="font-bold text-amber-300">₹@total.ToString("F2")</p>
                        </div>
                    }
                </div>

                <div class="border-t border-slate-800 pt-4 mb-6">
                    <div class="flex justify-between items-center text-lg font-bold">
                        <span>Total:</span>
                        <span class="text-amber-300">₹@orderTotal.ToString("F2")</span>
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-slate-200 mb-2">Customer Name</label>
                    <input type="text" @bind="customerName" placeholder="Your name"
                        class="w-full px-4 py-2 bg-slate-950 border border-slate-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-600 text-white" />
                </div>

                <div class="flex gap-3">
                    <button @onclick="CloseOrderDialog"
                        class="flex-1 px-4 py-3 border border-slate-700 text-slate-200 rounded-lg hover:bg-slate-800 transition font-semibold">
                        Cancel
                    </button>
                    <button @onclick="PlaceOrder" disabled="@(string.IsNullOrEmpty(customerName) || isSubmitting)"
                        class="flex-1 px-4 py-3 bg-amber-400 text-slate-900 rounded-lg hover:bg-amber-300 transition font-semibold disabled:opacity-50 disabled:cursor-not-allowed">
                        @if (isSubmitting)
                        {
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>Place Order</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MenuItemResponseDto> menuItems = new();
    private Dictionary<Guid, int> cart = new();
    private string searchQuery = "";
    private string selectedCategory = "";
    private bool isLoading = true;
    private bool showOrderDialog = false;
    private bool isSubmitting = false;
    private string customerName = "";
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMenuItems();
    }

    private async Task LoadMenuItems()
    {
        isLoading = true;
        try
        {
            menuItems = await ApiClient.GetMenuItemsAsync(
            string.IsNullOrEmpty(searchQuery) ? null : searchQuery,
            string.IsNullOrEmpty(selectedCategory) ? null : selectedCategory
            );
        }
        catch (Exception)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        await LoadMenuItems();
    }

    private async Task HandleCategoryChange(ChangeEventArgs e)
    {
        await LoadMenuItems();
    }

    private async Task HandleCategorySelectChange(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? "";
        await LoadMenuItems();
    }

    private async Task ResetFilters()
    {
        searchQuery = "";
        selectedCategory = "";
        await LoadMenuItems();
    }

    private void IncreaseQuantity(Guid itemId)
    {
        if (cart.ContainsKey(itemId))
            cart[itemId]++;
        else
            cart[itemId] = 1;
    }

    private void DecreaseQuantity(Guid itemId)
    {
        if (cart.ContainsKey(itemId) && cart[itemId] > 0)
        {
            cart[itemId]--;
            if (cart[itemId] == 0)
                cart.Remove(itemId);
        }
    }

    private int GetQuantity(Guid itemId) => cart.ContainsKey(itemId) ? cart[itemId] : 0;

    private decimal GetItemTotal(Guid itemId)
    {
        var item = menuItems.FirstOrDefault(m => m.Id == itemId);
        return item != null ? item.Price * GetQuantity(itemId) : 0;
    }

    private decimal orderTotal => cart.Sum(c => GetItemTotal(c.Key));

    private void ShowOrderDialog()
    {
        showOrderDialog = true;
        customerName = "";
    }

    private void CloseOrderDialog()
    {
        showOrderDialog = false;
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrEmpty(customerName) || cart.Count == 0)
            return;

        isSubmitting = true;
        try
        {
            var orderDto = new OrderCreateDto
            {
                OrderItems = cart.Select(c => new OrderItemsCreateDto
                {
                    MenuItemId = c.Key,
                    Quantity = c.Value
                }).ToList()
            };

            var result = await ApiClient.CreateOrderAsync(orderDto);
            if (result != null)
            {
                cart.Clear();
                showOrderDialog = false;
                Navigation.NavigateTo("/orders");
            }
        }
        catch (Exception ex)
        {
            // Handle error
        }
        finally
        {
            isSubmitting = false;
        }
    }
}