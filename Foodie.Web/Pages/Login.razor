@page "/login"
@inject NavigationManager Navigation
@layout EmptyLayout

<div class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-4">
    <div class="w-full max-w-md">
        <!-- Card -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-slate-900 to-slate-800 px-8 py-12 border-b border-slate-800">
                <h1 class="text-4xl font-bold text-white mb-2">Foodie</h1>
                <p class="text-slate-300">Delicious food at your doorstep</p>
            </div>

            <!-- Form -->
            <div class="px-8 py-8">
                <h2 class="text-2xl font-bold text-white mb-6">Welcome Back</h2>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
                        <p class="text-red-600 text-sm font-medium">@errorMessage</p>
                    </div>
                }

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-200 mb-2">Email</label>
                        <input type="email" @bind="username" placeholder="Enter your email"
                            class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition text-white" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-200 mb-2">Password</label>
                        <input type="password" @bind="password" placeholder="Enter your password" @onkeyup="HandleKeyUp"
                            class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition text-white" />
                    </div>
                </div>

                <!-- Demo Credentials -->
                <div class="mt-6 p-4 bg-slate-900 border border-slate-800 rounded-lg">
                    <p class="text-slate-100 text-xs font-semibold mb-2">Demo Credentials:</p>
                    <div class="text-slate-300 text-xs space-y-1">
                        <p><span class="font-semibold">Customer:</span> sreyas@gmail.com / sreyas@123</p>
                        <p><span class="font-semibold">Admin:</span> admin@gmail.com / admin@123</p>
                    </div>
                </div>

                <button @onclick="HandleLogin" disabled="@isLoading"
                    class="w-full mt-6 px-4 py-3 bg-slate-100 text-slate-900 font-bold rounded-lg hover:bg-white transition disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (isLoading)
                    {
                        <span>Logging in...</span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </button>
            </div>
        </div>

        <!-- Footer -->
        <div class="mt-6 text-center text-slate-400 text-sm">
            <p>© 2026 Foodie - Fast & Delicious Delivery</p>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        errorMessage = "";
        isLoading = true;

        try
        {
            // Validate credentials (hardcoded for dummy login)
            if ((username == "sreyas@gmail.com" && password == "sreyas@123"))
            {
                await Task.Delay(500); // Simulate loading
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else if ((username == "admin@gmail.com" && password == "admin@123"))
            {
                await Task.Delay(500); // Simulate loading
                Navigation.NavigateTo("/admin/orders", forceLoad: true);
            }
            else
            {
                errorMessage = "Invalid email or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Login failed. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }
}