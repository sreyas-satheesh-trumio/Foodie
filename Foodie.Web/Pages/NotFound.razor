@page "/not-found"
@layout EmptyLayout

<div class="min-h-screen bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
    <div class="text-center text-white">
        <h1 class="text-8xl font-bold mb-4">404</h1>
        <h2 class="text-4xl font-bold mb-4">Page Not Found</h2>
        <p class="text-xl mb-8">Sorry, the page you are looking for does not exist.</p>
        <a href="/"
            class="inline-block px-8 py-3 bg-white text-orange-600 font-bold rounded-lg hover:shadow-lg transition">
            🏠 Go to Home
        </a>
    </div>
</div>