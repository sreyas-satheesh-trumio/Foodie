@page "/orders"
@using Foodie.Web.Services
@using System.Text.Json
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>My Orders - Foodie</PageTitle>

<div class="p-8 bg-slate-950 text-slate-100 min-h-screen">
    @if (isLoading)
    {
        <div class="flex justify-center items-center py-12">
            <div class="text-center">
                <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-orange-500 mb-4"></div>
                <p class="text-slate-300">Loading your orders...</p>
            </div>
        </div>
    }
    else if (orders.Count == 0)
    {
        <div class="mt-8 text-center py-12 bg-slate-900 rounded-lg border-2 border-dashed border-slate-800">
            <div class="text-6xl mb-4"></div>
            <h2 class="text-2xl font-semibold text-slate-200 mb-2">No Orders Yet</h2>
            <p class="text-slate-300 mb-6">Start ordering delicious food from our menu</p>
            <a href="/"
                class="inline-block px-6 py-2 bg-amber-400 text-slate-900 rounded-lg hover:bg-amber-300 transition font-medium">
                Browse Menu
            </a>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var order in orders)
            {
                <div
                    class="bg-slate-900 rounded-xl shadow-md hover:shadow-lg transition border border-slate-800 overflow-hidden">
                    <!-- Order Header -->
                    <div class="bg-slate-800 px-6 py-4 border-b border-slate-700">
                        <div class="flex justify-between items-start flex-wrap gap-4">
                            <div>
                                <p class="text-sm text-slate-300">Order ID</p>
                                <p class="text-lg font-bold text-white">@order.Id.ToString().Substring(0, 8)...</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm text-slate-300">Ordered on</p>
                                <p class="text-lg font-bold text-white">@order.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                            </div>
                            <div>
                                <span
                                    class="inline-block px-4 py-2 rounded-full font-semibold text-white @GetStatusColor(order.Status)">
                                    @order.Status
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Order Items -->
                    <div class="px-6 py-4 bg-slate-950">
                        <h3 class="font-semibold text-white mb-3">Items:</h3>
                        <div class="space-y-2">
                            @foreach (var item in order.OrderItems)
                            {
                                <div class="flex justify-between items-center p-2 bg-slate-900 rounded border border-slate-800">
                                    <div>
                                        <p class="font-medium text-white">@item.MenuItem</p>
                                        <p class="text-sm text-slate-300">@item.Quantity × ₹@item.UnitPrice</p>
                                    </div>
                                    <p class="font-bold text-amber-300">₹@((item.UnitPrice * item.Quantity))</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Order Footer -->
                    <div class="px-6 py-4 flex justify-between items-center bg-slate-900 border-t border-slate-800">
                        <div class="text-right">
                            <p class="text-sm text-slate-300">Total Amount</p>
                            <p class="text-2xl font-bold text-amber-300">₹@order.TotalPrice</p>
                        </div>
                        <div class="flex gap-3">
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<OrderResponseDto> orders = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            orders = await ApiClient.GetOrdersAsync();
            Console.WriteLine(JsonSerializer.Serialize(orders));
        }
        catch (Exception)
        {
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.Placed => "bg-blue-500",
        OrderStatus.Preparing => "bg-yellow-500",
        OrderStatus.Delivered => "bg-green-500",
        _ => "bg-gray-500"
    };
}