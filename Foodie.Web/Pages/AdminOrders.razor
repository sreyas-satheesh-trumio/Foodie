@page "/admin/orders"
@layout AdminLayout
@using Foodie.Web.Services
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>All Orders - Admin - Foodie</PageTitle>

<div class="p-8 bg-slate-950 text-slate-100 min-h-screen">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-white mb-2">All Orders</h1>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center items-center py-12">
            <div class="text-center">
                <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-amber-400 mb-4"></div>
                <p class="text-slate-300">Loading orders...</p>
            </div>
        </div>
    }
    else if (orders.Count == 0)
    {
        <div class="bg-slate-900 rounded-xl shadow-md p-12 text-center border border-slate-800">
            <div class="text-6xl mb-4"></div>
            <h2 class="text-2xl font-bold text-white mb-2">No Orders</h2>
            <p class="text-slate-400">No orders placed yet</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6">
            @foreach (var order in orders)
            {
                <div
                    class="bg-slate-900 rounded-xl shadow-md border border-slate-800 overflow-hidden hover:shadow-lg transition">
                    <!-- Card Header -->
                    <div class="bg-slate-800 px-6 py-4 border-b border-slate-700">
                        <div class="flex justify-between items-start flex-wrap gap-4">
                            <div>
                                <p class="text-sm text-slate-400">Order ID</p>
                                <p class="text-lg font-bold text-white">@order.Id.ToString().Substring(0, 8)...</p>
                            </div>
                            <div>
                                <p class="text-sm text-slate-400">Customer</p>
                                <p class="text-lg font-bold text-white">@order.CustomerName</p>
                            </div>
                            <div>
                                <p class="text-sm text-slate-400">Ordered On</p>
                                <p class="text-lg font-bold text-white">@order.CreatedAt.ToString("MMM dd, HH:mm")</p>
                            </div>
                            <div>
                                <p class="text-sm text-slate-400">Status</p>
                                <span
                                    class="inline-block px-3 py-1 rounded-full font-semibold text-white text-sm @GetStatusColor(order.Status)">
                                    @order.Status
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Order Items -->
                    <div class="px-6 py-4 bg-slate-950">
                        <h3 class="font-semibold text-white mb-3">Items Ordered:</h3>
                        <div class="space-y-2">
                            @foreach (var item in order.OrderItems)
                            {
                                <div class="flex justify-between items-center p-3 bg-slate-900 rounded border border-slate-800">
                                    <div>
                                        <p class="font-medium text-white">@item.MenuItem</p>
                                        <p class="text-sm text-slate-300">Quantity: @item.Quantity</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm text-slate-300">₹@item.UnitPrice.ToString("F2") each</p>
                                        <p class="font-bold text-amber-300">₹@((item.UnitPrice * item.Quantity).ToString("F2"))</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Card Footer -->
                    <div class="px-6 py-4 flex justify-between items-center bg-slate-900 border-t border-slate-800">
                        <div class="text-right">
                            <p class="text-sm text-slate-400">Total Amount</p>
                            <p class="text-2xl font-bold text-amber-300">₹@order.TotalPrice.ToString("F2")</p>
                        </div>
                        <button @onclick="() => OpenStatusDialog(order)"
                            class="px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition font-semibold">
                            Update Status
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Status Update Dialog -->
@if (showStatusDialog && selectedOrder != null)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
        <div class="bg-slate-900 rounded-2xl shadow-2xl max-w-md w-full border border-slate-800">
            <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4 text-white">
                <h2 class="text-2xl font-bold">Update Order Status</h2>
                <p class="text-blue-100 text-sm">@selectedOrder.CustomerName's Order</p>
            </div>

            <div class="p-6">
                <p class="text-slate-300 text-sm mb-4">Current Status: <span
                        class="font-bold text-amber-300">@selectedOrder.Status</span>
                </p>

                <div class="space-y-3 mb-6">
                    @foreach (var status in Enum.GetValues(typeof(OrderStatus)).Cast<OrderStatus>())
                    {
                        var isCurrentStatus = selectedOrder.Status == status;
                        <button @onclick="() => UpdateStatus(status)" disabled="@isCurrentStatus"
                            class="w-full p-3 rounded-lg border-2 font-semibold transition @(isCurrentStatus ? "border-slate-700 bg-slate-800 text-slate-500 cursor-not-allowed" : "border-blue-500 text-blue-300 hover:bg-slate-800")">
                            @status.ToString()
                        </button>
                    }
                </div>

                <div class="flex gap-3">
                    <button @onclick="CloseStatusDialog"
                        class="flex-1 px-4 py-3 border border-slate-700 text-slate-300 rounded-lg hover:bg-slate-800 transition font-semibold">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<OrderResponseDto> orders = new();
    private bool isLoading = true;
    private bool showStatusDialog = false;
    private OrderResponseDto? selectedOrder = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            orders = await ApiClient.GetAllOrdersAsync();
        }
        catch (Exception ex)
        {
            // Handle error
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.Placed => "bg-blue-500",
        OrderStatus.Preparing => "bg-yellow-500",
        OrderStatus.Delivered => "bg-green-500",
        _ => "bg-slate-500"
    };

    private string GetStatusIcon(OrderStatus status) => status switch
    {
        OrderStatus.Placed => "[Placed]",
        OrderStatus.Preparing => "[Preparing]",
        OrderStatus.Delivered => "[Delivered]",
        _ => "[Unknown]"
    };

    private void OpenStatusDialog(OrderResponseDto order)
    {
        selectedOrder = order;
        showStatusDialog = true;
    }

    private void CloseStatusDialog()
    {
        showStatusDialog = false;
        selectedOrder = null;
    }

    private async Task UpdateStatus(OrderStatus newStatus)
    {
        if (selectedOrder == null)
            return;

        try
        {
            var result = await ApiClient.UpdateOrderStatusAsync(selectedOrder.Id, newStatus);
            if (result != null)
            {
                var orderToUpdate = orders.FirstOrDefault(o => o.Id == selectedOrder.Id);
                if (orderToUpdate != null)
                {
                    orderToUpdate.Status = newStatus;
                }
                CloseStatusDialog();
            }
        }
        catch (Exception ex)
        {
            // Handle error
        }
    }
}